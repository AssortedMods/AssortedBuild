#!/usr/bin/env bash
# The Assorted mods as one thing. Every command works over the checkouts that sit beside this
# repository (or under $FLEET_ROOT), driven by repos.yaml. `fleet help` lists them.
#
# Deliberately plain bash + git + gh: it has to run from Git Bash on Windows and from a GitHub
# runner with nothing installed.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
build_root="$(dirname "$here")"
root="${FLEET_ROOT:-$(dirname "$build_root")}"
manifest="$here/repos.yaml"

usage() {
    cat <<'EOF'
fleet - the Assorted mods as one thing

  fleet list                        every mod in the checked-out repos, with its publishing ids
  fleet status                      branch, dirt and versions of every checkout; who is behind
  fleet clone                       clone whichever repos are missing beside AssortedBuild
  fleet exec <command...>           run a command in every checkout (fleet exec git pull)
  fleet bump-build [<version>]      set assortedbuild_version everywhere (default: this repo's)
  fleet pr <branch> <message>       in every dirty checkout: branch, commit, push, open a PR
  fleet release <target> [flags]    dispatch the Build workflow; a dry run unless --real. The target
                                    is a repo (AssortedTech, the whole of it), a mod id
                                    (assortedgraves, that mod alone) or all (every repo)
        --real  --type <release|beta|alpha>  --version <v>  --client-gametests  --publish-maven
        --ref <branch>   (default: the checkout's current branch)
        --batch <n>      release n mods at a time instead of everything at once
        --every <min>    minutes between batches (default 60)
        --remote         hand the batches to the Release train workflow instead of waiting here
  fleet mixins [<repo>...]          check every mixin against the decompiled sources a build left
                                    behind, including that a hooked call is still in its method.
                                    Needs Python and a build of each repo first
  fleet new <"Mod Name"> <short> <"description"> [--into <dir>] [--lib <version>]
                                    scaffold a mod from template/, e.g.
                                    fleet new "Assorted Example" example "Adds an example."

Checkouts are looked for at $FLEET_ROOT/<repo name>, defaulting to the directory above this one.
repos.yaml names only the repos; the mods and their ids are read from each checkout.
EOF
}

die() {
    echo "fleet: $*" >&2
    exit 1
}

need() {
    command -v "$1" >/dev/null 2>&1 || die "$1 is not installed$2"
}

# The repos in repos.yaml, in order.
repos() {
    sed -n 's/^  - \([^ #]*\).*/\1/p' "$manifest"
}

# The checkout of a repo, named for it: AssortedMods/AssortedUtil sits at $root/AssortedUtil.
mod_dir() {
    echo "$root/${1##*/}"
}

# A mod's own gradle.properties: mods/<dir> in a family repo, the root of a one-mod repo.
mod_properties() {
    if [ "$2" = "." ]; then echo "$(mod_dir "$1")/gradle.properties"; else echo "$(mod_dir "$1")/mods/$2/gradle.properties"; fi
}

prop() {
    # prop <file> <key>: the value, or nothing when the file or the key is absent. Must not fail:
    # under `set -e -o pipefail` a failing command substitution in an assignment ends the script,
    # and `new` legitimately runs where no sibling checkout exists (a runner).
    [ -f "$1" ] || return 0
    sed -n "/^$2=/{s/^$2=//p;q}" "$1"
}

build_version() {
    prop "$build_root/gradle.properties" version
}

# Every mod of every checkout as TSV: repo, dir, id. dir is "." for a repo that is one mod, and a
# repo not checked out comes out once with "-" for both.
mods() {
    repos | while read -r repo; do
        local dir mods
        dir="$(mod_dir "$repo")"
        if [ ! -d "$dir" ]; then
            printf '%s\t-\t-\n' "$repo"
            continue
        fi
        mods="$(prop "$dir/gradle.properties" assorted_mods)"
        if [ -z "$mods" ]; then
            printf '%s\t.\t%s\n' "$repo" "$(prop "$dir/gradle.properties" mod_id)"
        else
            for mod in ${mods//,/ }; do
                printf '%s\t%s\t%s\n' "$repo" "$mod" "$(prop "$(mod_properties "$repo" "$mod")" mod_id)"
            done
        fi
    done
}

cmd_list() {
    printf '%-28s %-14s %-22s %-10s %s\n' REPO DIR ID MODRINTH CURSE
    mods | while IFS=$'\t' read -r repo mod id; do
        local file
        file="$(mod_properties "$repo" "$mod")"
        if [ "$mod" = "-" ]; then
            printf '%-28s %s\n' "$repo" "(not checked out - fleet clone)"
            continue
        fi
        printf '%-28s %-14s %-22s %-10s %s\n' "$repo" "$mod" "$id" "$(prop "$file" modrinth_id)" "$(prop "$file" curseforge_id)"
    done
}

cmd_status() {
    local current
    current="$(build_version)"
    echo "AssortedBuild $current"
    printf '%-24s %-22s %-6s %-9s %-9s %-9s %s\n' MOD BRANCH DIRTY VERSION BUILD LIB NOTE
    mods | while IFS=$'\t' read -r repo mod id; do
        local dir branch dirty version build lib note
        dir="$(mod_dir "$repo")"
        if [ ! -d "$dir/.git" ]; then
            printf '%-24s %s\n' "${repo##*/}" "(not checked out - fleet clone)"
            continue
        fi
        # A family's branch, dirt and pins are the repo's; only the version is the mod's own.
        branch="$(git -C "$dir" branch --show-current)"
        dirty="$(git -C "$dir" status --porcelain | wc -l | tr -d ' ')"
        version="$(prop "$(mod_properties "$repo" "$mod")" version)"
        build="$(prop "$dir/gradle.properties" assortedbuild_version)"
        lib="$(prop "$dir/gradle.properties" assortedlib_version)"
        note=""
        [ -z "$build" ] && note="not on AssortedBuild"
        [ -n "$build" ] && [ "$build" != "$current" ] && note="behind ($current)"
        printf '%-24s %-22s %-6s %-9s %-9s %-9s %s\n' "${id:-${repo##*/}}" "$branch" "$dirty" "$version" "${build:--}" "${lib:--}" "$note"
    done
}

cmd_clone() {
    repos | while read -r repo; do
        local dir
        dir="$(mod_dir "$repo")"
        if [ -d "$dir/.git" ]; then
            echo "${repo##*/}: present"
        else
            echo "${repo##*/}: cloning $repo"
            git clone "https://github.com/$repo.git" "$dir"
        fi
    done
}

cmd_exec() {
    [ $# -gt 0 ] || die "exec needs a command"
    repos | while read -r repo; do
        local dir
        dir="$(mod_dir "$repo")"
        [ -d "$dir" ] || continue
        echo "==> ${repo##*/}"
        (cd "$dir" && "$@") || echo "fleet: ${repo##*/}: exit $?" >&2
    done
}

cmd_mixins() {
    local python="" dirs=()
    # Windows answers python3 with a Store shortcut that runs nothing, so each is tried.
    for candidate in python3 python; do
        if "$candidate" -c '' >/dev/null 2>&1; then python="$candidate"; break; fi
    done
    [ -n "$python" ] || die "mixins needs Python"
    if [ $# -gt 0 ]; then
        for repo in "$@"; do dirs+=("$(mod_dir "$repo")"); done
    else
        while read -r repo; do
            [ -d "$(mod_dir "$repo")" ] && dirs+=("$(mod_dir "$repo")")
        done < <(repos)
    fi
    "$python" "$here/mixin_check.py" "${dirs[@]}"
}

cmd_bump_build() {
    local version="${1:-$(build_version)}"
    repos | while read -r repo; do
        local dir file name
        dir="$(mod_dir "$repo")"
        name="${repo##*/}"
        file="$dir/gradle.properties"
        [ -f "$file" ] || continue
        if grep -q '^assortedbuild_version=' "$file"; then
            sed -i "s/^assortedbuild_version=.*/assortedbuild_version=$version/" "$file"
            echo "$name: assortedbuild_version=$version"
        else
            echo "$name: not on AssortedBuild, skipped"
        fi
    done
}

cmd_pr() {
    need gh " - https://cli.github.com"
    local branch="${1:-}" message="${2:-}"
    [ -n "$branch" ] && [ -n "$message" ] || die "pr needs a branch name and a commit message"
    repos | while read -r repo; do
        local dir base name
        dir="$(mod_dir "$repo")"
        name="${repo##*/}"
        [ -d "$dir/.git" ] || continue
        if [ -z "$(git -C "$dir" status --porcelain)" ]; then
            echo "$name: clean, skipped"
            continue
        fi
        base="$(git -C "$dir" branch --show-current)"
        echo "==> $name: $base -> $branch"
        git -C "$dir" checkout -q -b "$branch"
        git -C "$dir" add -A
        git -C "$dir" commit -q -m "$message"
        git -C "$dir" push -q -u origin "$branch"
        gh pr create -R "$repo" --base "$base" --head "$branch" --title "$message" --body "$message"
    done
}

cmd_release() {
    need gh " - https://cli.github.com"
    local target="${1:-}"
    [ -n "$target" ] || die "release needs a repo, a mod id or 'all'"
    shift
    # pass holds the flags that cmd_dispatch (and the train workflow) take as they are.
    local pass=() ref="" batch="" every=60 remote=false
    local dry_run=true type=release version="" client=false maven=false
    while [ $# -gt 0 ]; do
        case "$1" in
            --real) dry_run=false; pass+=( "$1" ) ;;
            --type) type="$2"; pass+=( "$1" "$2" ); shift ;;
            --version) version="$2"; pass+=( "$1" "$2" ); shift ;;
            --client-gametests) client=true; pass+=( "$1" ) ;;
            --publish-maven) maven=true; pass+=( "$1" ) ;;
            --ref) ref="$2"; shift ;;
            --batch) batch="$2"; shift ;;
            --every) every="$2"; shift ;;
            --remote) remote=true ;;
            *) die "release: unknown flag $1" ;;
        esac
        shift
    done
    [ -z "$batch" ] || [[ "$batch" =~ ^[1-9][0-9]*$ ]] || die "--batch must be a number above 0"
    [[ "$every" =~ ^[0-9]+$ ]] || die "--every must be a number of minutes"
    [ "$remote" = false ] || [ -n "$batch" ] || die "--remote needs --batch"
    # A train run sleeps through the wait, and a GitHub job ends at six hours.
    [ "$remote" = false ] || [ "$every" -le 300 ] || die "--every can be at most 300 with --remote"

    # repo<TAB>dir; batching counts mods, so a repo splits into its mods unless "." (one whole run).
    local list
    if [ "$target" = all ] || repos | grep -qx "[^/]*/$target"; then
        if [ -n "$batch" ]; then
            list="$(mods | awk -F'\t' -v t="$target" '{ n = $1; sub(/.*\//, "", n) } t == "all" || n == t { print $1 "\t" $2 }')"
        else
            list="$(repos | while read -r repo; do
                if [ "$target" = all ] || [ "${repo##*/}" = "$target" ]; then printf '%s\t.\n' "$repo"; fi
            done)"
        fi
    else
        list="$(mods | awk -F'\t' -v id="$target" '$3 == id { print $1 "\t" $2 }')"
    fi
    [ -n "$list" ] || die "release: $target is not a repo in repos.yaml or a mod id in a checkout"

    # The queue, as repo@ref for a whole repo or repo@ref#dir for one mod of a family.
    local entries=() repo mod use_ref
    while IFS=$'\t' read -r repo mod; do
        [ "$mod" != "-" ] || die "${repo##*/} is not checked out (fleet clone)"
        use_ref="$ref"
        [ -n "$use_ref" ] || use_ref="$(git -C "$(mod_dir "$repo")" branch --show-current 2>/dev/null || true)"
        [ -n "$use_ref" ] || die "${repo##*/}: no --ref and no checkout to read the branch from"
        if [ "$mod" = "." ]; then entries+=( "$repo@$use_ref" ); else entries+=( "$repo@$use_ref#$mod" ); fi
    done <<<"$list"

    if [ -z "$batch" ]; then
        cmd_dispatch "${pass[@]}" -- "${entries[@]}"
        return
    fi

    echo "${#entries[@]} mods in batches of $batch, $every minutes apart"
    if [ "$remote" = true ]; then
        gh workflow run release-train.yml -R AssortedMods/AssortedBuild --ref main \
            -f queue="${entries[*]}" -f batch="$batch" -f every="$every" \
            -f dry_run="$dry_run" -f release_type="$type" -f version="$version" \
            -f client_gametests="$client" -f publish_maven="$maven"
        echo "The Release train workflow in AssortedMods/AssortedBuild has the queue now. Cancel its newest run to stop it."
        return
    fi

    while :; do
        echo "--- $(date +%H:%M), ${#entries[@]} left"
        cmd_dispatch "${pass[@]}" -- "${entries[@]:0:batch}"
        entries=( "${entries[@]:batch}" )
        [ ${#entries[@]} -gt 0 ] || break
        echo "--- next batch at $(date -d "+$every minutes" +%H:%M) (Ctrl+C stops the rest)"
        sleep $((every * 60))
    done
}

# Starts the Build workflow for queue entries (repo@ref or repo@ref#dir). Neighboring mods of the
# same repo share one run through its mods input. The release train workflow calls this too.
cmd_dispatch() {
    need gh " - https://cli.github.com"
    local dry_run=true type=release version="" client=false maven=false
    while [ $# -gt 0 ]; do
        case "$1" in
            --real) dry_run=false ;;
            --type) type="$2"; shift ;;
            --version) version="$2"; shift ;;
            --client-gametests) client=true ;;
            --publish-maven) maven=true ;;
            --) shift; break ;;
            *) die "dispatch: unknown flag $1" ;;
        esac
        shift
    done
    [ $# -gt 0 ] || die "dispatch needs at least one repo@ref or repo@ref#dir"

    # The empty entry at the end flushes the last run.
    local entry key dir pending="" mods=""
    for entry in "$@" ""; do
        key="${entry%%#*}"
        dir=""
        [ "$key" = "$entry" ] || dir="${entry#*#}"
        if [ -n "$pending" ] && [ -n "$mods" ] && [ -n "$dir" ] && [ "$key" = "$pending" ]; then
            mods="$mods,$dir"
            continue
        fi
        if [ -n "$pending" ]; then
            local only=()
            [ -z "$mods" ] || only=( -f mods="$mods" )
            echo "==> $pending${mods:+ ($mods)} release dry_run=$dry_run type=$type version='${version}'"
            gh workflow run build.yml -R "${pending%%@*}" --ref "${pending#*@}" \
                -f release=true -f dry_run="$dry_run" -f release_type="$type" -f version="$version" \
                -f client_gametests="$client" -f publish_maven="$maven" "${only[@]}"
        fi
        pending="$key"
        mods="$dir"
    done
}

# Replaces every placeholder in a scaffolded tree: file contents first (text files only - the
# wrapper jar and the logo must not be touched), then the path segments.
cmd_new() {
    local name="${1:-}" short="${2:-}" description="${3:-}"
    [ -n "$name" ] && [ -n "$short" ] && [ -n "$description" ] || die "new needs a name, a short id and a description"
    shift 3
    local into="" lib=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --into) into="$2"; shift ;;
            --lib) lib="$2"; shift ;;
            *) die "new: unknown flag $1" ;;
        esac
        shift
    done
    [[ "$short" =~ ^[a-z][a-z0-9]*$ ]] || die "the short id must be lowercase letters and digits, like 'tools'"

    local class repo id pkg
    class="$(tr '[:lower:]' '[:upper:]' <<<"${short:0:1}")${short:1}"
    repo="Assorted$class"
    id="assorted$short"
    pkg="$short"
    [ -n "$into" ] || into="$root/$repo"
    [ ! -e "$into" ] || die "$into already exists"

    local minecraft build
    minecraft="$(sed -n 's/^minecraft = "\(.*\)"/\1/p' "$build_root/gradle/libs.versions.toml")"
    build="$(build_version)"

    # The AssortedLib a new mod starts on: --lib, else the sibling checkout's version, else the
    # newest one published for this Minecraft version. The template holds only a placeholder.
    if [ -z "$lib" ]; then
        lib="$(prop "$(mod_dir AssortedLib)/gradle.properties" version)"
    fi
    if [ -z "$lib" ]; then
        local url metadata
        url="https://maven.grimoid.com/mods/com/grim3212/assorted/lib/assortedlib-common-$minecraft/maven-metadata.xml"
        # curl's own error stays visible: what the maven answered is the whole diagnosis when this
        # runs somewhere it is reachable from differently, like a CI runner.
        if metadata="$(curl -fsS "$url")"; then
            lib="$(sed -n 's/.*<latest>\(.*\)<\/latest>.*/\1/p' <<<"$metadata" | tr -d '\r')"
        else
            echo "fleet: could not read $url" >&2
        fi
    fi
    [ -n "$lib" ] || die "cannot tell which AssortedLib to start on; pass --lib <version>"

    cp -R "$build_root/template" "$into"
    chmod +x "$into/gradlew"

    # sed on the text files only; grep -I skips the binaries. `|| true` because grep exits 1 on
    # no match, which pipefail would turn into a script exit.
    { grep -rIl --exclude-dir=.git '__MOD_\|__MC__\|__ASSORTEDBUILD_VERSION__\|__ASSORTEDLIB_VERSION__' "$into" || true; } | while read -r file; do
        sed -i \
            -e "s|__MOD_NAME__|$name|g" \
            -e "s|__MOD_DESCRIPTION__|$description|g" \
            -e "s|__MOD_REPO__|$repo|g" \
            -e "s|__MOD_CLASS__|$class|g" \
            -e "s|__MOD_ID__|$id|g" \
            -e "s|__MOD_PKG__|$pkg|g" \
            -e "s|__MC__|$minecraft|g" \
            -e "s|__ASSORTEDBUILD_VERSION__|$build|g" \
            -e "s|__ASSORTEDLIB_VERSION__|$lib|g" \
            "$file"
    done

    # Paths: deepest first so a renamed parent never invalidates a child's path.
    find "$into" -depth -name '*__MOD_*' | while read -r path; do
        local base new
        base="$(basename "$path")"
        new="${base//__MOD_REPO__/$repo}"
        new="${new//__MOD_CLASS__/$class}"
        new="${new//__MOD_PKG__/$pkg}"
        new="${new//__MOD_ID__/$id}"
        [ "$new" != "$base" ] && mv "$path" "$(dirname "$path")/$new"
    done

    git -C "$into" init -q -b "$minecraft"

    cat <<EOF
Scaffolded $name in $into
  mod id      $id
  package     com.grim3212.assorted.$pkg
  classes     ${class}CommonMod, ${repo}Fabric, ${repo}NeoForge, ...
  AssortedLib >= $lib, AssortedBuild $build, Minecraft $minecraft

Next:
  1. Replace common/src/main/resources/logo.png.
  2. Create github.com/AssortedMods/$repo, then set modrinth_id and curseforge_id in gradle.properties
     once those projects exist (blank ids publish nowhere).
  3. Add AssortedMods/$repo to fleet/repos.yaml.
  4. cd $into && ./gradlew build
EOF
}

case "${1:-help}" in
    list) shift; cmd_list "$@" ;;
    status) shift; cmd_status "$@" ;;
    clone) shift; cmd_clone "$@" ;;
    exec) shift; cmd_exec "$@" ;;
    bump-build) shift; cmd_bump_build "$@" ;;
    pr) shift; cmd_pr "$@" ;;
    release) shift; cmd_release "$@" ;;
    dispatch) shift; cmd_dispatch "$@" ;;
    new) shift; cmd_new "$@" ;;
    mixins) shift; cmd_mixins "$@" ;;
    help|-h|--help) usage ;;
    *) usage >&2; exit 1 ;;
esac
